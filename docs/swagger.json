{
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "This is a sample recipes API. You can find out more about the API at https://github.com/mel-ak/recipes-api",
        "title": "Recipes API",
        "contact": {
            "name": "Melak Sisay",
            "url": "https://me-port-sigma.vercel.app/",
            "email": "melakesisay@gmail.com"
        },
        "version": "1.0.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/recipes": {
            "get": {
                "description": "Gets a comprehensive list of all recipes currently available.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "recipes"
                ],
                "summary": "List all recipes",
                "operationId": "listRecipes // Added ID tag based on user input",
                "responses": {
                    "200": {
                        "description": "Successfully retrieved list of recipes",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.Recipe"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a new recipe and stores it in the database.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "recipes"
                ],
                "summary": "Create a new recipe",
                "operationId": "newRecipe",
                "parameters": [
                    {
                        "description": "Recipe object to be created",
                        "name": "recipe",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.Recipe"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Successfully created the recipe",
                        "schema": {
                            "$ref": "#/definitions/main.Recipe"
                        }
                    },
                    "400": {
                        "description": "Invalid input or validation failed",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/recipes/search": {
            "get": {
                "description": "Search for recipes based on tags or other criteria.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "recipes"
                ],
                "summary": "Search recipes",
                "operationId": "searchRecipes",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tag to filter recipes by",
                        "name": "tag",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of matching recipes",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.Recipe"
                            }
                        }
                    }
                }
            }
        },
        "/recipes/{id}": {
            "put": {
                "description": "Updates the details of a recipe specified by its ID.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "recipes"
                ],
                "summary": "Update an existing recipe",
                "operationId": "updateRecipe",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID of the recipe",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Recipe object that needs to be updated",
                        "name": "recipe",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.Recipe"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation, returns the updated recipe",
                        "schema": {
                            "$ref": "#/definitions/main.Recipe"
                        }
                    },
                    "400": {
                        "description": "Invalid input or validation failed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Invalid recipe ID / Recipe not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Deletes a recipe based on the provided ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "recipes"
                ],
                "summary": "Delete a recipe",
                "operationId": "deleteRecipe",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID of the recipe to be deleted",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content, deletion successful"
                    },
                    "404": {
                        "description": "Recipe ID not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.Recipe": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "the id for the recipe\nread only: true\nexample: 60e9d1f37e19a6b83f3e69f8",
                    "type": "string"
                },
                "ingredients": {
                    "description": "A list of ingredients needed for the recipe\nrequired: true",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "instructions": {
                    "description": "Step-by-step instructions\nrequired: true",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "name": {
                    "description": "The name of the recipe\nrequired: true\nmin length: 3\nexample: Spaghetti Carbonara",
                    "type": "string"
                },
                "publishedAt": {
                    "description": "The date the recipe was published",
                    "type": "string"
                },
                "tags": {
                    "description": "A list of tags for categorization (e.g., Italian, Pasta)\nexample: [\"Italian\", \"Dinner\"]",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}